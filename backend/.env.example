# Copy to .env and edit. Every value here already has a working default in
# app/core/config.py, so this file is optional for local development.

ENVIRONMENT=development
DEBUG=true

# SQLite, async driver. Use an absolute path in production.
DATABASE_URL=sqlite+aiosqlite:///./signal.db

# Replace before deploying anywhere public.
JWT_SECRET=dev-only-secret-replace-in-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Mocked phone verification. EXPOSE_OTP_IN_RESPONSE must be false in production.
MOCK_OTP_CODE=123456
OTP_TTL_SECONDS=300
EXPOSE_OTP_IN_RESPONSE=true

# The deployed frontend origin. A JSON array, one URL, or URLs separated by commas.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
